{
	"name": "rust-dataset-bench",
	"private": true,
	"workspaces": [
		"apps/backend",
		"apps/react-client",
		"apps/solid-client"
	],
	"scripts": {
		"dev": "turbo run dev",
		"dev:backend": "turbo run dev --filter=backend",
		"dev:react": "turbo run dev --filter=react-client",
		"dev:solid": "turbo run dev --filter=solid-client",
		"build": "turbo run build",
		"build:backend": "turbo run build --filter=backend",
		"build:react": "turbo run build --filter=react-client",
		"build:solid": "turbo run build --filter=solid-client",
		"test": "turbo test",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"type-check": "turbo run type-check",
		"generate-types": "node scripts/generate-types.mjs",
		"generate-types:react": "turbo run generate-types --filter=react-client",
		"generate-types:solid": "turbo run generate-types --filter=solid-client"
	},
	"devDependencies": {
		"turbo": "^2.6.1"
	},
	"packageManager": "yarn@4.5.3",
	"engines": {
		"node": ">=20.0.0",
		"yarn": ">=4.0.0"
	}
}
